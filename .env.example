# Summit Build Co — AI Creative System
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Anthropic Claude — primary copy generation (model: claude-sonnet-4-6)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI — comparison copy (gpt-5.5) and image creatives (gpt-image-1, highest
# quality). Powers the Campaign Reactor "Generate creative" action.
OPENAI_API_KEY=your_openai_api_key_here

# Voyage AI — embeddings for the Reactor knowledge layer (voyage-3, 1024-dim).
# Without this, retrieval falls back to the curated demo intelligence.
VOYAGE_API_KEY=your_voyage_api_key_here

# Higgsfield — image + video creative via the official SDK (@higgsfield/client).
# Format: "KEY_ID:KEY_SECRET" from https://cloud.higgsfield.ai/api-keys
# Powers the Campaign Reactor generate_image / generate_video agent tools and the
# /api/generate-image and /api/generate-video routes. Without it, those degrade
# to demo mode (no creative is produced; copy still works).
HF_CREDENTIALS=your_key_id:your_key_secret
# Optional overrides for the Higgsfield endpoints/model:
# HIGGSFIELD_IMAGE_ENDPOINT=/v1/text2image/soul
# HIGGSFIELD_VIDEO_ENDPOINT=/v1/image2video/dop
# HIGGSFIELD_VIDEO_MODEL=dop-turbo

# Muapi — unified gateway to the frontier image AND video models behind ONE
# key, and the CURRENT DEFAULT for both ovens. Images: Nano Banana Pro, GPT
# Image 2, Imagen 4 Ultra, Nano Banana 2, Seedream, FLUX 3, FLUX Kontext Max,
# Midjourney, FLUX Dev. Video: Veo 3.1, Veo 4, Seedance 2.0 (+ Fast), Kling
# 3.0, Wan 2.7. Get a key at https://muapi.ai. MUAPI_API_KEY is also accepted.
#
# SANDBOX KEYS return mock data instantly and spend no credits — use one to
# prove the wiring end to end without burning trial credit, then swap in the
# live key. Remove the key entirely and both ovens fall through to Kie / fal /
# Higgsfield automatically; nothing throws.
#
# Verify a key with:  MUAPIAPP_API_KEY=<key> npm run muapi:slugs
MUAPIAPP_API_KEY=your_muapi_key_here
# Optional. Endpoint slugs are taken VERBATIM from muapi.ai/llms.txt and follow
# NO single convention — bare (nano-banana-pro), mode-suffixed
# (gpt-image-2-text-to-image), versioned (midjourney-v8), vendor-prefixed
# (bytedance-seedream-5.0-pro). Never "tidy" one into a pattern: guessing is
# what once 404'd every frontier model and dropped the oven onto FLUX.1 Dev,
# the weakest text renderer, which shipped ads with misspelled headlines.
# `npm run muapi:slugs` prints the override to set when a vendor renames one.
# MUAPI_API_BASE=https://api.muapi.ai/api/v1
# MUAPI_POLL_TIMEOUT_MS=50000
# MUAPI_IMAGE_RESOLUTION=2k        # 1k/2k/4k — 1k is where headline letters go soft
# MUAPI_MODEL_NANO_BANANA_PRO=nano-banana-pro
# MUAPI_MODEL_GPT_IMAGE_2=gpt-image-2-text-to-image
# MUAPI_MODEL_MIDJOURNEY=midjourney-v8
# MUAPI_VIDEO_VEO31_T2V=veo3.1-text-to-video
# MUAPI_VIDEO_KLING3_I2V=kling-v3.0-pro-image-to-video
# (full list of MUAPI_MODEL_* / MUAPI_VIDEO_* overrides in CLAUDE.md)

# fal.ai — single gateway to the frontier image + video models (FLUX stills;
# Seedance / Kling / Veo / Wan video). One key unlocks all of them. Powers the
# Campaign Reactor generate_image / generate_video agent tools and the
# /api/generate-image and /api/generate-video routes. Get a key at
# https://fal.ai/dashboard/keys and add credits there. Without it (and no other
# image/video provider), creative generation degrades to demo mode.
FAL_KEY=your_fal_key_here
# Optional override for the fal still-image model (defaults to fal-ai/flux/dev):
# FAL_IMAGE_MODEL=fal-ai/flux/dev

# Kie.ai — one key unlocks the flagship image market (Nano Banana Pro, Seedream
# 4.0, FLUX Kontext Max, GPT Image, Nano Banana). Get a key at https://kie.ai.
# The oven prefers these when set; falls back to fal/Higgsfield otherwise.
KIE_API_KEY=your_kie_key_here
# Optional per-model slug overrides (vendor paths drift — correct here, no code
# change needed). Defaults shown:
# KIE_MODEL_NANO_BANANA_PRO=google/nano-banana-pro
# KIE_MODEL_SEEDREAM=bytedance/seedream-v4-text-to-image
# KIE_MODEL_FLUX_KONTEXT=black-forest-labs/flux-kontext-max
# KIE_MODEL_GPT_IMAGE=gpt-image-2-text-to-image
# KIE_MODEL_NANO_BANANA=google/nano-banana
# Optional overrides for fal video model endpoints (defaults track current gen):
# FAL_SEEDANCE_T2V=bytedance/seedance-2.0/text-to-video
# FAL_SEEDANCE_I2V=bytedance/seedance-2.0/image-to-video

# Google Gemini — Nano Banana 2 still-image model (fast creative variants).
# Powers the "nano-banana" image model. GOOGLE_API_KEY also accepted.
GEMINI_API_KEY=your_gemini_api_key_here

# Meta Ads MCP (Pipeboard) — live ad-performance tools for the Campaign Reactor
# agent via Anthropic's MCP connector. Get a token at https://pipeboard.co/api-tokens
# Without it, the agent simply runs without the Meta Ads tools.
PIPEBOARD_API_TOKEN=your_pipeboard_token_here
# Optional: point at a self-hosted Meta Ads MCP instead of Pipeboard's hosted one.
# META_ADS_MCP_URL=https://meta-ads.mcp.pipeboard.co/

# Meta's first-party Ads MCP (mcp.facebook.com/ads) — alternative to Pipeboard.
# Auth is an OAuth bearer access token (not a query param). Set this to test it.
# META_ADS_ACCESS_TOKEN=your_meta_oauth_access_token_here
# Optional override of the first-party endpoint URL.
# META_ADS_FIRSTPARTY_URL=https://mcp.facebook.com/ads
# Default provider when a run doesn't specify one: "pipeboard" (default) or "meta".
# A single run can override this by sending { "metaProvider": "meta" } in the POST body.
# META_ADS_PROVIDER=pipeboard

# Meta Marketing API (direct Graph API) — powers the /meta dashboard with live
# ad performance. Generate a System User token in Business Manager → Business
# Settings → System Users with ads_read, ads_management, business_management.
# A connected account is live from the first dollar — META_LIVE_MIN_SPEND can
# reintroduce a floor if a deployment wants one. Verify with GET /api/meta/status.
#
# Instead of setting the token here, you can connect Meta from the dashboard
# itself: Meta Intelligence → Meta Connection validates the token against the
# Graph API and stores it server-side (platform_settings). A stored connection
# wins over these env vars; the env vars remain the fallback, and removing the
# stored connection puts them back in charge.
# META_ACCESS_TOKEN=your_long_lived_system_user_token_here
# META_APP_ID=your_app_id
# META_APP_SECRET=your_app_secret              # optional — enables appsecret_proof signing
# META_API_VERSION=v19.0                        # optional — Graph API version
# META_LIVE_MIN_SPEND=0                         # optional — spend floor before live data shows (default 0: connected = live from the first dollar)
# META_AD_ACCOUNT_ID=1234567890                 # ad account id (publish + Mike's live source)
# META_PAGE_ID=1234567890                       # page id (creative publish only)

# Mike Delight live source — set to "meta" so the operator reads the real ad
# account through /api/operator/source. Anything else keeps the seeded demo
# account. Verify with: npm run selftest:operator-meta
# NEXT_PUBLIC_OPERATOR_SOURCE=meta
# NEXT_PUBLIC_OPERATOR_TARGET_CPR=45            # Mike's cost-per-result target for rules
# NEXT_PUBLIC_OPERATOR_ACCOUNT_TZ=Australia/Brisbane  # optional first guess — the account's timezone_name wins
# NEXT_PUBLIC_OPERATOR_NAME=Bamik               # who Mike greets by name on first login — the welcome is fixed copy, per deployment

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
